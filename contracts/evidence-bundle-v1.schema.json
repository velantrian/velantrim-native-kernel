{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/velantrian/velantrim-native-kernel/contracts/evidence-bundle-v1.schema.json",
  "title": "Native Kernel Evidence Bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "bundle_id",
    "captured_at",
    "repository",
    "plan",
    "checkpoints",
    "assertion_map",
    "nk_epi",
    "boundaries"
  ],
  "allOf": [
    {
      "if": {
        "required": [
          "evidence_purpose"
        ]
      },
      "then": {
        "required": [
          "sqlite_integrity"
        ]
      },
      "else": {
        "not": {
          "required": [
            "sqlite_integrity"
          ]
        }
      }
    }
  ],
  "properties": {
    "protocol": {
      "const": "nk-evidence-bundle/1"
    },
    "bundle_id": {
      "type": "string",
      "minLength": 1
    },
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "repository": {
      "const": "velantrian/velantrim-native-kernel"
    },
    "evidence_purpose": {
      "const": "ADR_0023_SQLITE_INTEGRITY_REVALIDATION"
    },
    "sqlite_integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "minimum_linked_version",
        "historical_bundle_id",
        "historical_manifest_path",
        "historical_bundle_preserved",
        "historical_bundle_rewritten",
        "assertion_arithmetic_changed",
        "nk_epi_changed"
      ],
      "properties": {
        "decision": {
          "const": "ADR-0023"
        },
        "minimum_linked_version": {
          "const": "3.51.3"
        },
        "historical_bundle_id": {
          "const": "native-kernel/c5/2026-08-07"
        },
        "historical_manifest_path": {
          "const": "evidence/c5/2026-08-07/manifest.json"
        },
        "historical_bundle_preserved": {
          "const": true
        },
        "historical_bundle_rewritten": {
          "const": false
        },
        "assertion_arithmetic_changed": {
          "const": false
        },
        "nk_epi_changed": {
          "const": false
        }
      }
    },
    "plan": {
      "type": "object",
      "required": [
        "id",
        "protocol",
        "sha256",
        "scenario_count"
      ]
    },
    "checkpoints": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2
    },
    "assertion_map": {
      "type": "object",
      "required": [
        "supported",
        "partial",
        "unsupported",
        "failed"
      ]
    },
    "nk_epi": {
      "type": "object",
      "required": [
        "supported",
        "partial",
        "unsupported",
        "failed"
      ]
    },
    "boundaries": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "string"
      }
    }
  }
}
