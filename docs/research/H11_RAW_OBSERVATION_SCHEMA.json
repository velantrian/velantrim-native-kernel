{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nk-h11-raw-observations/1",
  "title": "H11 raw observations",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "repositoryArtifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "artifact_type", "git_commit"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "artifact_type": {"const": "REPOSITORY_SOURCE"},
        "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    }
  },
  "required": [
    "protocol",
    "experiment_id",
    "source_plan_id",
    "source_plan_sha256",
    "observation_layer",
    "observations",
    "missing_data"
  ],
  "properties": {
    "protocol": {"const": "nk-h11-raw-observations/1"},
    "experiment_id": {"const": "H11-001"},
    "source_plan_id": {"const": "H11-001-c5-lab-canon-separation-v1"},
    "source_plan_sha256": {"const": "60da649e675b79b3e70bf8a61cf03cb4d57bb989f4934b65ab8d50c925b19914"},
    "observation_layer": {"const": "RAW_FACTS_ONLY_NO_H11_SEMANTIC_JUDGMENT"},
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "observation_id",
          "observation_kind",
          "observation_type",
          "producer_identity",
          "producer_authority_class",
          "source_reference",
          "repository_visible",
          "fact",
          "structured_value"
        ],
        "properties": {
          "observation_id": {"type": "string", "minLength": 1},
          "observation_kind": {
            "enum": [
              "BUNDLE_VERIFICATION",
              "MANIFEST_IDENTITY",
              "ARTIFACT_INVENTORY",
              "DEPENDENCY_EDGE",
              "SOURCE_REFERENCE",
              "MECHANISM_CLASSIFICATION_INPUT",
              "REVIEWER_IDENTITY_EVIDENCE",
              "INDEPENDENCE_EVIDENCE",
              "MISSING_DATA"
            ]
          },
          "observation_type": {
            "enum": [
              "DIRECT_MEASUREMENT",
              "REPOSITORY_INSPECTION",
              "TOOL_OUTPUT",
              "DECLARED_MISSING_DATA"
            ]
          },
          "producer_identity": {"type": "string", "minLength": 1},
          "producer_authority_class": {
            "enum": [
              "SUBJECT_IMPLEMENTATION",
              "CI_RUNNER",
              "AUTOMATED_VALIDATOR",
              "REPOSITORY_OBSERVER",
              "QUALIFYING_INDEPENDENT_REVIEWER",
              "NON_QUALIFYING_REVIEW_BOT"
            ]
          },
          "source_reference": {"$ref": "#/$defs/repositoryArtifactReference"},
          "repository_visible": {"type": "boolean"},
          "fact": {
            "enum": [
              "BUNDLE_VERIFICATION_OBSERVED",
              "MANIFEST_IDENTITY_OBSERVED",
              "ARTIFACT_INVENTORY_OBSERVED",
              "DEPENDENCY_EDGE_OBSERVED",
              "SOURCE_REFERENCE_OBSERVED",
              "MECHANISM_CLASSIFICATION_INPUT_OBSERVED",
              "REVIEWER_IDENTITY_EVIDENCE_OBSERVED",
              "INDEPENDENCE_EVIDENCE_OBSERVED",
              "MISSING_DATA_OBSERVED"
            ]
          },
          "structured_value": {"type": "object"}
        },
        "allOf": [
          {
            "if": {
              "properties": {"observation_kind": {"const": "DEPENDENCY_EDGE"}},
              "required": ["observation_kind"]
            },
            "then": {
              "properties": {
                "fact": {"const": "DEPENDENCY_EDGE_OBSERVED"},
                "structured_value": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["edge_id", "from", "to", "edge_class"],
                  "properties": {
                    "edge_id": {"type": "string", "minLength": 1},
                    "from": {"type": "string", "minLength": 1},
                    "to": {"type": "string", "minLength": 1},
                    "edge_class": {
                      "enum": [
                        "MEANING_LEVEL_JUSTIFICATION",
                        "LAB_REPRODUCTION_REQUIRES",
                        "PROFILE_REALIZES",
                        "ARCHITECTURE_REQUIRES",
                        "VALIDATOR_DEPENDS_ON"
                      ]
                    }
                  }
                }
              }
            }
          },
          {
            "if": {"properties": {"observation_kind": {"const": "BUNDLE_VERIFICATION"}}, "required": ["observation_kind"]},
            "then": {
              "properties": {
                "fact": {"const": "BUNDLE_VERIFICATION_OBSERVED"},
                "structured_value": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["bundle_id", "manifest_path", "exact_bundle_verified", "verifier_exit_code", "verified_artifact_count"],
                  "properties": {
                    "bundle_id": {"type": "string", "minLength": 1},
                    "manifest_path": {"type": "string", "minLength": 1},
                    "exact_bundle_verified": {"type": "boolean"},
                    "verifier_exit_code": {"type": "integer"},
                    "verified_artifact_count": {"type": "integer", "minimum": 0}
                  }
                }
              }
            }
          },
          {
            "if": {"properties": {"observation_kind": {"const": "MANIFEST_IDENTITY"}}, "required": ["observation_kind"]},
            "then": {
              "properties": {
                "fact": {"const": "MANIFEST_IDENTITY_OBSERVED"},
                "structured_value": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["bundle_id", "manifest_path", "manifest_sha256"],
                  "properties": {
                    "bundle_id": {"type": "string", "minLength": 1},
                    "manifest_path": {"type": "string", "minLength": 1},
                    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
                  }
                }
              }
            }
          },
          {
            "if": {"properties": {"observation_kind": {"const": "ARTIFACT_INVENTORY"}}, "required": ["observation_kind"]},
            "then": {
              "properties": {
                "fact": {"const": "ARTIFACT_INVENTORY_OBSERVED"},
                "structured_value": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["bundle_id", "artifact_count", "inventory_sha256"],
                  "properties": {
                    "bundle_id": {"type": "string", "minLength": 1},
                    "artifact_count": {"type": "integer", "minimum": 0},
                    "inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
                  }
                }
              }
            }
          },
          {
            "if": {"properties": {"observation_kind": {"const": "SOURCE_REFERENCE"}}, "required": ["observation_kind"]},
            "then": {
              "properties": {
                "fact": {"const": "SOURCE_REFERENCE_OBSERVED"},
                "structured_value": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["path", "sha256"],
                  "properties": {
                    "path": {"type": "string", "minLength": 1},
                    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
                  }
                }
              }
            }
          },
          {
            "if": {"properties": {"observation_kind": {"const": "MECHANISM_CLASSIFICATION_INPUT"}}, "required": ["observation_kind"]},
            "then": {
              "properties": {
                "fact": {"const": "MECHANISM_CLASSIFICATION_INPUT_OBSERVED"},
                "structured_value": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["mechanism_name", "dependency_edge_id"],
                  "properties": {
                    "mechanism_name": {"type": "string", "minLength": 1},
                    "dependency_edge_id": {"type": "string", "minLength": 1}
                  }
                }
              }
            }
          },
          {
            "if": {"properties": {"observation_kind": {"const": "REVIEWER_IDENTITY_EVIDENCE"}}, "required": ["observation_kind"]},
            "then": {
              "properties": {
                "fact": {"const": "REVIEWER_IDENTITY_EVIDENCE_OBSERVED"},
                "structured_value": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["identity", "role"],
                  "properties": {
                    "identity": {"type": "string", "minLength": 1},
                    "role": {"enum": ["REVIEWER", "REPRODUCER", "REVIEWER_AND_REPRODUCER"]}
                  }
                }
              }
            }
          },
          {
            "if": {"properties": {"observation_kind": {"const": "INDEPENDENCE_EVIDENCE"}}, "required": ["observation_kind"]},
            "then": {
              "properties": {
                "fact": {"const": "INDEPENDENCE_EVIDENCE_OBSERVED"},
                "structured_value": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["basis_type"],
                  "properties": {
                    "basis_type": {"enum": ["ORGANIZATIONAL_SEPARATION", "INDEPENDENT_EVIDENCE_CUSTODY", "NON_AUTHORSHIP", "CONFLICT_SCREEN", "PRIVATE_STATE_EXCLUSION"]}
                  }
                }
              }
            }
          },
          {
            "if": {"properties": {"observation_kind": {"const": "MISSING_DATA"}}, "required": ["observation_kind"]},
            "then": {
              "properties": {
                "fact": {"const": "MISSING_DATA_OBSERVED"},
                "structured_value": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["missing_id", "effect_on_visibility"],
                  "properties": {
                    "missing_id": {"type": "string", "minLength": 1},
                    "effect_on_visibility": {"enum": ["MATERIAL", "NON_MATERIAL"]}
                  }
                }
              }
            }
          }
        ]
      }
    },
    "missing_data": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["missing_id", "description", "effect_on_visibility"],
        "properties": {
          "missing_id": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "effect_on_visibility": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
